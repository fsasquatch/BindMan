package bindman.generator;

import bindman.CTypes;
using StringTools;

class HL {
    static function getType(type:BindType):String {
        switch(type) {
            case Invalid:
                return "Dynamic";
            case Void:
                return 'Void';
            case Int8:
                return 'Int';
            case Int16:
                return 'Int';
            case Int32:
                return 'Int';
            case Int64:
                return 'hl.I64';
            case UInt8:
                return 'Int';
            case UInt16:
                return 'Int';
            case UInt32:
                return 'Int';
            case UInt64:
                return 'Int';
            case SizeT:
                return 'Int';
            case Float32:
                return 'Single';
            case Float64:
                return 'Float';
            case Char:
                return 'Int';
            case String:
                return 'String';
            case Boolean:
                return "Bool";
            case Struct(name):
                return Utils.titlecase(name);
            case Array(type, size):
                Sys.println('HLgen: $type[$size] (Not Implemented)');
                return "Dynamic"; // TODO
            case Pointer(type):
                if(type == Char) return "String";
                else if(type == Void) return "hl.Bytes";
                return 'hl.Ref<${getType(type)}>';
            case FunctionPointer(name):
                Sys.println('HLgen: $name (Not Implemented)');
                return "Dynamic";
            case WChar:
                // NOTE: ???
                return "Int";
            case VarList:
                Sys.println('HLgen: VarList (Not Implemented)');
                return "VARLIST";
        }

        return null;
    }

    public static function generate(lib:CLib, header:String, o:String, libName:String):String {
        var code = '// This file was auto-generated by BindMan.\npackage $o;\n\n';

        for(struct in lib.structs) {
            if(struct.opaque) {
                code += 'typedef ${Utils.titlecase(struct.name)} = hl.Abstract<"${struct.name.toLowerCase()}">;\n';
            }
        }
        code += '\n';

        for(struct in lib.structs) {
            if(struct.opaque) continue;
            code += '@:struct\n';
            code += 'class ${Utils.titlecase(struct.name)} {\n';

            for(f in struct.fields) code += '    public var ${f.name}:${getType(f.type)};\n';
            code += '\n';

            code += '   public function new() {}\n';
            code += '}\n\n';
        }

        for(e in lib.enums) {
            if(e.name == null) continue;
            code += 'enum abstract ${Utils.titlecase(e.name)}(${getType(e.fields[0].type)}) from ${getType(e.fields[0].type)} to ${getType(e.fields[0].type)} {\n';
            for(f in e.fields) code += '    var ${f.name}:${getType(f.type)} = ${f.value};\n';
            code += '}\n\n';
        }

        for(t in lib.typedefs) {
            code += 'typedef ${Utils.titlecase(t.name)} = ${getType(t.type)};\n';
        }
        code += '\n';

        // var lib_name = header.split(".")[0];
        // code += '@:hlNative("${header.split(".")[0]}")\n';
        code += 'extern class ${Utils.titlecase(header.split(".")[0])} {\n';
        for(fn in lib.functions) {
            var params = '';
            for(p in fn.parameters) params += '${p.name}:${getType(p.type)},';
            params = params.substr(0, -1).ltrim().rtrim();
            code += '    @:hlNative("${libName}_native", "${fn.name.toLowerCase()}") static function ${fn.name}($params):${getType(fn.returnType)};\n';
        }
        code += '}';

        return code;
    }
}