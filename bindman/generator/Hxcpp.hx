package bindman.generator;

import bindman.CTypes;
using StringTools;

class Hxcpp {
    public static function getType(type:BindType):String {
        switch(type) {
            case Invalid:
                return 'Invalid';
            case Void:
                return 'cpp.Void';
            case Int8:
                return 'cpp.Int8';
            case Int16:
                return 'cpp.Int16';
            case Int32:
                return 'cpp.Int32';
            case Int64:
                return 'cpp.Int64';
            case UInt8:
                return 'cpp.UInt8';
            case UInt16:
                return 'cpp.UInt16';
            case UInt32:
                return 'cpp.UInt32';
            case UInt64:
                return "cpp.UInt64";
            case Float32:
                return 'cpp.Float32';
            case Float64:
                return 'cpp.Float64';
            case Char:
                return 'cpp.Char';
            case String:
                return 'cpp.ConstCharStar';
            case Boolean:
                return 'Bool';
            case Struct(name):
                return Utils.titlecase(name);
            case Array(type, size):
                switch(type) {
                    case Struct(value): 
                        return Utils.titlecase(value);
                    default:
                        return 'cpp.${getType(type).replace("cpp.", "")}Pointer';
                }
            case Pointer(value):
                switch(value) {
                    case Struct(v):
                        return 'haxe.extern.AsVar<${Utils.titlecase(v)}>';
                    case Pointer(v):
                        if(v == Char) return 'cpp.CastCharStarPointer';
                        return 'cpp.RawPointer<${getType(v)}>';
                    case Boolean:
                        return 'cpp.BoolPointer';
                    default:
                        return getType(value)+'Pointer';
                }
            case FunctionPointer(name):
                Sys.println('HxcppGen: $name (Not Implemented)');
                return 'Dynamic';
            case WChar:
                return "cpp.WChar";
            case VarList:
                return "cpp.VarList";
        }
        return null;
    }

    public static function generate(lib:CLib, includeHeader:String, cppXML:String):String {
        var code = "// This file was auto-generated by BindMan.\npackage interop;\n\n";

        for(s in lib.structs) {
            code += '@:semantics(value)\n';
            code += '@:include("${includeHeader}")\n';
            if(!s.opaque) code += '@:cpp.ValueType({type: "${s.name}"})\n';
            else code += '@:cpp.PointerType({type: "${s.name}"})\n';
            code += 'extern class ${Utils.titlecase(s.name)} {\n';
            if(!s.opaque) {
                for(field in s.fields) code += '    var ${field.name}:${getType(field.type)};\n';
                code += '\n    function new():Void;\n';
            }
            code += '}\n\n';
        }

        for(e in lib.enums) {
            code += '@:semantics(value)\n';
            code += '@:include("${includeHeader}")\n';
            code += '@:cpp.ValueType({type: "${e.name}"})\n';
            code += 'extern enum abstract ${Utils.titlecase(e.name)}(${getType(e.fields[0].type)}) {\n';
            for(field in e.fields) code += '    @:native("${field.name}") var ${field.name};\n';
            code += '}\n\n';
        }

        for(t in lib.typedefs) {
            code += 'typedef ${Utils.titlecase(t.name)} = ${getType(t.type)};\n\n';
        }

        code += "@:keep\n";
        code += '@:buildXml("$cppXML")\n';
        code += '@:include("${includeHeader}")\n';
        code += 'extern class ${Utils.titlecase(includeHeader.split(".")[0])} {\n';
        for(f in lib.functions) {
            var params = '';
            for(p in f.parameters) params += '${p.name}:${getType(p.type)},';
            params = params.substr(0, -1).ltrim().rtrim();
            code += '    @:native("${f.name}") static function ${f.name}($params):${getType(f.returnType)};\n';
        }
        code += "}";

        return code;
    }
}