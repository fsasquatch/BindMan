package bindman.generator;

import bindman.CTypes;
using StringTools;

class HLExt {
    static function getType(type:BindType):String {
        switch (type) {
            case Invalid:
                return "INVALID_TYPE";
            case Void:
                return "void";
            case Int8:
                return "char";
            case Int16:
                return "short";
            case Int32:
                return "int";
            case Int64:
                return "long long";
            case UInt8:
                return "unsigned char";
            case UInt16:
                return "unsigned short";
            case UInt32:
                return "unsigned int";
            case UInt64:
                return "unsigned long long"; 
            case Float32:
                return "float";
            case Float64:
                return "double";
            case Char:
                return "char";
            case String:
                return "vstring*";
            case Boolean:
                return "bool";
            case Struct(name):
                return name;
            case Array(type, size):
                return "ARRAY_TYPE";
            case Pointer(type):
                if(type == Char) return "vstring*";
                else if(type == Void) return "vbyte*";
                return getType(type)+'*';
            case FunctionPointer(name):
                return "FUNCTION_POINTER";
            case WChar:
                // NOTE: ???
                return "int";
            case VarList:
                return "VARLIST";
        }
        return null;
    }

    static function getHLType(type:BindType):String {
        switch (type) {
            case Invalid:
                return "INVALID_TYPE";
            case Void:
                return "_VOID";
            case Int8:
                return "_I8";
            case Int16:
                return "_I16";
            case Int32:
                return "_I32";
            case Int64:
                return "_I64";
            case UInt8:
                return "_I32"; // NOTE: kinda gave up here...
            case UInt16:
                return "_I32";
            case UInt32:
                return "_I32";
            case UInt64:
                return "_I32"; 
            case Float32:
                return "_F32";
            case Float64:
                return "_F64";
            case Char:
                return "_I32";
            case String:
                return "_STRING";
            case Boolean:
                return "_BOOL";
            case Struct(name):
                return "_STRUCT";
            case Array(type, size):
                return "ARRAY_TYPE";
            case Pointer(type):
                if(type == Char) return "_STRING";
                if(type == Void) return "_BYTES";
                return '_REF(${getHLType(type)})';
            case FunctionPointer(name):
                return "FUNCTION_POINTER";
            case WChar:
                // NOTE: ???
                return "_I32";
            case VarList:
                return "VARLIST";
        }
        return null;
    }

    public static function generate(libName:String, lib:CLib, header:String):String {
        var abstracts:Array<String> = [];

        var code = "// This file was auto-generated by BindMan.\n";
        code  += '#define HL_NAME(n) ${libName}_##n\n';
        code += '#include <hl.h>\n';
        code += '#include "${header}"\n\n';

        for(struct in lib.structs) {
            // opaque structs become abstracts (i think?)
            if(struct.opaque) {
                code += '#define _${struct.name.toUpperCase()} _ABSTRACT(${struct.name.toLowerCase()})\n';
                abstracts.push(struct.name);
            }
        }
        code += '\n';

        for(fn in lib.functions) {
            var pstr = [];
            for(p in fn.parameters) {
                var type = getType(p.type);
                pstr.push('${type} ${p.name}');
            }

            code += 'HL_PRIM ${getType(fn.returnType)} HL_NAME(${fn.name})(';
            
            var params = '';
            for(p in pstr) params += p+',';
            params = params.substr(0, -1).ltrim().rtrim();
            code += params;

            code += ') {\n';
            for(p in fn.parameters) {
                if(getType(p.type) == "vstring**") {
                    code += '    char* __${p.name} = hl_to_utf8((*${p.name})->bytes);\n';
                }
            }
            code += '    ${fn.name}(';

            var call_params = '';
            for(p in fn.parameters) {
                if(getType(p.type) == 'vstring*') {
                    call_params += 'hl_to_utf8(${p.name}->bytes),';
                } else if(getType(p.type) == "vstring**") {
                    call_params += '&__${p.name},';
                } else {
                    call_params += p.name+',';
                }
            }
            call_params = call_params.substr(0, -1).ltrim().rtrim();
            code += call_params;

            code += ');\n';
            code += '}\n';

            var hlparams = [];
            for(p in fn.parameters) {
                switch(p.type) {
                    case Struct(name):
                        if(abstracts.contains(name)) {
                            hlparams.push('_${name.toUpperCase()}');
                        } else {
                            hlparams.push(getHLType(p.type));
                        }
                    default:
                        hlparams.push(getHLType(p.type));
                }
            }
            var hlparams_str = hlparams.toString().replace(',', ' ').replace('[', '').replace(']', '').ltrim().rtrim();
            if(hlparams.length == 0) hlparams_str = '_NO_ARG';
            code += 'DEFINE_PRIM(${getHLType(fn.returnType)}, ${fn.name}, $hlparams_str);\n\n';
        }

        return code;
    }
}